    {
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "type": "logs",
      "title": "Runs on main",
      "description": "Every completed rc workflow run on main.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
