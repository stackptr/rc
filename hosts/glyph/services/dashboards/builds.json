          "refId": "A",
          "expr": "{unit=\"github-actions-log.service\"} | json | repo=\"stackptr/rc\" | branch=\"main\" | kind=\"run\" | line_format \"{{.conclusion}}  {{.workflow}}  {{.title}}  {{.url}}\""
