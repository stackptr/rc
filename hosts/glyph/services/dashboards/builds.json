{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Deploys",
        "expr": "{app=~\"nixos-deploy|deploy-rs\", priority=~\"[0-5]\"}",
        "target": {
          "refId": "Anno",
          "expr": "{app=~\"nixos-deploy|deploy-rs\", priority=~\"[0-5]\"}"
        },
        "tagKeys": "host,app",
        "titleFormat": "Deploy: {{host}}",
        "textFormat": ""
      }
    ]
  },
  "description": "Build and deploy status from GitHub Actions, polled into Loki by github-actions-log.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "type": "stat",
      "title": "CI on main",
      "description": "The latest completed build of each host on main, from the last 14 days. Skipped darwin builds (no flake.lock or ci.yml change) are left out, so it shows the last one that ran.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "passed",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "cancelled",
                  "color": "text",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({unit=\"github-actions-log.service\"} | json | repo=\"stackptr/rc\" | branch=\"main\" | kind=\"job\" | workflow=\"ci.yml\" | event=\"push\" | job=~\"(build|eval) .*\" | conclusion!=\"skipped\" | label_format target=`{{ regexReplaceAll \"^[a-z]+ [(]|[,)].*$\" .job \"\" }}{{ if hasPrefix \"eval\" .job }} eval{{ end }}`, status=`{{ if eq .conclusion \"success\" }}1{{ else if eq .conclusion \"cancelled\" }}2{{ else }}0{{ end }}` | unwrap status | __error__=\"\" [14d]) by (target)",
          "queryType": "instant",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "type": "stat",
      "title": "Deploys",
      "description": "The latest Deploy of each host from the last 14 days. Cancelled means superseded by a newer run, or never approved.",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "passed",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "cancelled",
                  "color": "text",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({unit=\"github-actions-log.service\"} | json | repo=\"stackptr/rc\" | branch=\"main\" | kind=\"job\" | workflow=\"deploy.yml\" | job=~\"deploy .*\" | conclusion!=\"skipped\" | label_format target=`{{ regexReplaceAll \"^[a-z]+ [(]|[,)].*$\" .job \"\" }}`, status=`{{ if eq .conclusion \"success\" }}1{{ else if eq .conclusion \"cancelled\" }}2{{ else }}0{{ end }}` | unwrap status | __error__=\"\" [14d]) by (target)",
          "queryType": "instant",
          "legendFormat": "{{target}}"
        }
      ]
    },
    {
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
