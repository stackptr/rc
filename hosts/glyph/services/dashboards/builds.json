        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time({unit=\"github-actions-log.service\"} | json | repo=\"stackptr/rc\" | branch=\"main\" | kind=\"run\" | workflow=\"update.yml\" | label_format target=\"flake update\", status=`{{ if eq .conclusion \"success\" }}1{{ else if eq .conclusion \"cancelled\" }}2{{ else }}0{{ end }}` | unwrap status | __error__=\"\" [14d]) by (target)",
          "queryType": "instant",
          "legendFormat": "{{target}}"
