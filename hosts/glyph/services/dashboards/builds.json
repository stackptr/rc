        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min_over_time({unit=\"github-actions-log.service\"} | json | repo=\"stackptr/rc\" | branch=\"main\" | kind=\"job\" | workflow=\"ci.yml\" | event=\"push\" | job=~\"(build|eval) .*\" | conclusion!=\"skipped\" | label_format target=`{{ regexReplaceAll \"^[a-z]+ [(]|[,)].*$\" .job \"\" }}{{ if hasPrefix \"eval\" .job }} eval{{ end }}`, status=`{{ if eq .conclusion \"success\" }}1{{ else if eq .conclusion \"cancelled\" }}2{{ else }}0{{ end }}` | unwrap status | __error__=\"\" [$__interval]) by (target)",
          "queryType": "range",
          "legendFormat": "{{target}}"
        }
      ]
    },
