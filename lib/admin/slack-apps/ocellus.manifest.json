{
    "display_information": {
        "name": "Ocellus",
        "description": "Read-only eyes for my agents: lets them read #alerts and #updates through the MCP gateway on glyph.",
        "background_color": "#1F2A44"
    },
    "features": {
        "bot_user": {
            "display_name": "Ocellus",
            "always_online": false
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "channels:history",
                "channels:read",
                "groups:history",
                "groups:read",
                "im:read",
                "mpim:read",
                "users:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false
    }
}
