# Renders docs/ports.md: what each host's firewall lets in, by where the
# connection comes from. `scripts/ports` writes it and CI checks it's current.
{
  lib,
  nixosConfigurations,
  darwinConfigurations,
  network,
}: let
  inherit (lib) concatStringsSep concatMap optional;

  fmtRange = r:
    if r.from == r.to
    then toString r.from
    else "${toString r.from}–${toString r.to}";

  fmtPorts = ports: ranges: let
    all = map toString (lib.sort lib.lessThan ports) ++ map fmtRange ranges;
  in
    if all == []
    then "none"
    else concatStringsSep ", " all;

  portTable = fw: [
    "| Protocol | Ports |"
    "|---|---|"
    "| TCP | ${fmtPorts fw.allowedTCPPorts fw.allowedTCPPortRanges} |"
    "| UDP | ${fmtPorts fw.allowedUDPPorts fw.allowedUDPPortRanges} |"
  ];

  # Whether the firewall's global lists accept this port from anywhere
  allows = fw: protocol: port: let
    p = lib.toUpper protocol;
  in
    builtins.elem port fw."allowed${p}Ports"
    || lib.any (r: r.from <= port && port <= r.to) fw."allowed${p}PortRanges";

  # Rules added in extraCommands, without the NixOS NAT cleanup boilerplate
  extraRules = fw:
    builtins.filter (line: builtins.match "(ip46tables|iptables|ip6tables)( .*)? -[AI] .*" line != null)
    (map lib.trim (lib.splitString "\n" fw.extraCommands));

  # Per-interface allow lists, except tailscale0's: tailscaled accepts all
  # tailnet traffic before the NixOS firewall sees it
  interfaceRules = fw:
    lib.filterAttrs (
      name: i:
        name
        != "tailscale0"
        && i.allowedTCPPorts ++ i.allowedTCPPortRanges ++ i.allowedUDPPorts ++ i.allowedUDPPortRanges != []
    )
    fw.interfaces;

  forwardTable = host: fw: let
    forwards = builtins.filter (f: f.host == host) network.forwards;
    check = f:
      concatStringsSep ", " (map (p: "${lib.toUpper p} ${
          if allows fw p f.port
          then "yes"
          else "**no**"
        }")
        f.protocols);
  in
    if forwards == []
    then ["None."]
    else
      [
        "| Port | Protocols | Families | For | Firewall allows |"
        "|---|---|---|---|---|"
      ]
      ++ map (f: "| ${toString f.port} | ${concatStringsSep ", " (map lib.toUpper f.protocols)} | ${concatStringsSep ", " f.families} | ${f.description} | ${check f} |") forwards;

  nixosHost = host: let
    fw = nixosConfigurations.${host}.config.networking.firewall;
    public = builtins.elem host network.public;
    interfaces = interfaceRules fw;
    rules = extraRules fw;
  in
    [
      "## ${host}"
      ""
    ]
    ++ (
      if public
      then
        [
          "**Internet** (public address; the firewall's global allow lists):"
          ""
        ]
        ++ portTable fw
      else
        [
          "**Internet** (router port forwards in `lib/network.nix`):"
          ""
        ]
        ++ forwardTable host fw
        ++ [
          ""
          "**LAN** (the firewall's global allow lists):"
          ""
        ]
        ++ portTable fw
    )
    ++ concatMap (name: let
      i = interfaces.${name};
    in [
      ""
      "On `${name}` only: TCP ${fmtPorts i.allowedTCPPorts i.allowedTCPPortRanges}; UDP ${fmtPorts i.allowedUDPPorts i.allowedUDPPortRanges}."
    ]) (builtins.attrNames interfaces)
    ++ optional (rules != []) (concatStringsSep "\n" ([
        ""
        "Extra rules (`networking.firewall.extraCommands`):"
        ""
        "```sh"
      ]
      ++ rules
      ++ ["```"]))
    ++ [
      ""
      "**Tailnet**: everything${lib.optionalString (lib.any (lib.hasInfix "-t mangle") rules) ", except what the mangle rules above drop"}."
      ""
    ];

  fmtFirewallOption = v:
    if v == null
    then "unmanaged"
    else if v
    then "on"
    else "off";

  darwinHost = host: let
    alf = darwinConfigurations.${host}.config.networking.applicationFirewall;
  in "| ${host} | ${fmtFirewallOption alf.enable} | ${fmtFirewallOption alf.enableStealthMode} | ${fmtFirewallOption alf.blockAllIncoming} |";
in
  concatStringsSep "\n" (
    [
      "# Open ports"
      ""
      "Generated by `scripts/ports` from the evaluated host configurations, and checked by CI: edit the Nix, then rerun it."
      ""
      "- **Internet**: spore's firewall (public IPv4 address; IPv6 is off), and the router's port forwards to home hosts."
      "- **LAN**: the home network. Each home host's global allow lists, plus its extra rules."
      "- **Tailnet**: tailscaled's `ts-input` chain, first in filter `INPUT`, accepts all traffic from `tailscale0`, so neither `trustedInterfaces` nor `tailscale0` allow lists filter it. Only a rule in an earlier table (mangle) does."
      ""
      "An allowed port with nothing listening on it is closed: this lists what the firewall lets through, not what's running."
      ""
    ]
    ++ concatMap nixosHost (builtins.attrNames nixosConfigurations)
    ++ [
      "## Macs"
      ""
      "No inbound port forwards, so reachable only from the LAN they're on and the tailnet. The application firewall (`networking.applicationFirewall`) filters per app, not per port:"
      ""
      "| Host | Firewall | Stealth mode | Block all incoming |"
      "|---|---|---|---|"
    ]
    ++ map darwinHost (builtins.attrNames darwinConfigurations)
    ++ [""]
  )
